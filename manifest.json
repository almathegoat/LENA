{
  "manifest_version": 3,
  "name": "Lena — Assistante intelligente",
  "version": "0.2.0",
  "description": "Assistante vocale et traduction de page en langues camerounaises (prototype hackathon SAFINUM Innovate 2026).",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Lena — ouvrir l'assistante",
    "default_icon": { "16": "icons/tb16.png", "32": "icons/tb32.png", "48": "icons/tb48.png", "128": "icons/tb128.png" }
  },
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "browser_specific_settings": { "gecko": { "id": "lena@safinum-hackathon.cm" } },
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*", "file:///*"],
      "run_at": "document_idle",
      "all_frames": false,
      "js": [
        "content/logo-data.js", "dict/duala.js", "dict/ewondo.js", "dict/fulfulde.js",
        "content/protect.js", "content/translator.js", "content/assistant.js",
        "content/ui-styles.js", "content/ui.js", "content/main.js"
      ]
    }
  ]
}
